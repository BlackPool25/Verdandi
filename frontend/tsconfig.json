{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "incremental": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"],
  // T5/T7/T8/T9-owned specs excluded from the gate (need @types/node, not installed); their owners enable them.
  // T12 reduced-motion.spec.ts follows the same precedent (node:fs import).
  "exclude": ["e2e/controls.spec.ts", "e2e/events.spec.ts", "e2e/panels.spec.ts", "e2e/storms.spec.ts", "src/test/render-counter.spec.ts", "src/test/reduced-motion.spec.ts", "src/components/events/anomaly.spec.ts", "node_modules", "dist"]
}
